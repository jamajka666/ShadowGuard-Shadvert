# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real API keys.

# GEMINI_API_KEY: Required for Gemini AI analysis of ads.
# Get it from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL (Cloudflare Tunnel domain)
APP_URL="https://shadowguard-shadvert.site"

# Server port (cloudflared proxies to this)
PORT=3000

# Bind address — production should be 127.0.0.1 (Cloudflare Tunnel only)
# HOST=127.0.0.1

# App version string — bump when you want clients to refresh
APP_VERSION=1.0.0

# Admin panel token (Bearer) for /admin and /api/family admin routes
ADMIN_TOKEN="CHANGE_ME_LONG_RANDOM_TOKEN"

# Shared family code — family devices use this to sync history
FAMILY_CODE="CHANGE_ME_FAMILY_CODE"

# Optional security tuning (defaults are fine for family use)
# JSON_BODY_LIMIT=2mb
# MAX_IMAGE_BASE64_CHARS=1500000
# MAX_URL_CHARS=2000
# MAX_USER_NOTE_CHARS=2000
# RATE_LIMIT_API_MAX=200
# RATE_LIMIT_HEAVY_MAX=40
# SCAM_ALERTS_CACHE_TTL_MS=1800000
# SCAM_ALERTS_ERROR_CACHE_TTL_MS=300000
# SCAM_ALERTS_TIMEOUT_MS=12000
# Trust Engine: bump when hybrid/kill-switch rules change
# RULES_VERSION=rules-2026-08-06
# VERDICT_CACHE_TTL_MS=600000
